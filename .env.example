# Copy this file to ".env" and put your own key there.
# NEVER put a real key in this file. NEVER commit ".env".

API_KEY=your_api_key_here

# --- Option A: Groq (free tier) ---
BASE_URL=https://api.groq.com/openai/v1
MODEL=llama-3.3-70b-versatile

# --- Option B: OpenAI ---
# BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini

# --- Option C: Google Gemini (free tier) ---
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL=gemini-2.0-flash

# --- Optional settings (defaults shown) ---
# MAX_UPLOAD_MB=10          # biggest PDF accepted
# MAX_PAGES=100             # most pages accepted
# CHUNK_CHARS=900           # size of each text piece
# CHUNK_OVERLAP=150         # overlap between pieces
# TOP_K=4                   # pieces sent to the AI per question
# MAX_QUESTION_CHARS=500    # longest question
# MAX_DOCS=20               # documents kept in memory
# DOC_TTL_SECONDS=7200      # forget documents after this many seconds
# RATE_LIMIT_PER_MIN=20     # requests per IP per minute
# REQUEST_TIMEOUT=30        # seconds to wait for the AI
# FLASK_DEBUG=0             # set to 1 only while developing
